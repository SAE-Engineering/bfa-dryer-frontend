# Panel (production) overlay for the on-machine HMI — Lenovo M700 "bfa-hmi-01".
# Serves the frontend on host :80 so the kiosk browser hits http://localhost/.
# Bring up on the panel with:
#   docker compose -f docker-compose.yml -f docker-compose.panel.yml up -d --build
# (Do NOT name this docker-compose.override.yml — that auto-merges and would make
#  the bosun dev box also try to bind :80.)
services:
  backend:
    # Two serial leads, pinned by stable USB by-id paths -> fixed in-container
    # names, so kernel ttyUSB enumeration order (which can swap on reboot/replug)
    # can never cross RS485 (Teco) with RS232 (ABB):
    #   /dev/ttyTECO = FTDI FT232R USB-RS485  -> the 3 Teco E510s (spinner/ag2/trace)
    #   /dev/ttyABB  = Prolific USB-RS232     -> the ABB ACS355 that replaced agitator1
    # Both adapters are permanent panel fixtures; if a lead is unplugged the device
    # node is absent and `up -d` will refuse to start until it's back.
    devices:
      - "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B000VA8O-if00-port0:/dev/ttyTECO"
      - "/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller_EPBPb147612-if00-port0:/dev/ttyABB"
    environment:
      - VSD_SERIAL_PORT=/dev/ttyTECO
      - VSD_SERIAL_BAUD=9600
      - ABB_SERIAL_PORT=/dev/ttyABB
      - ABB_SERIAL_BAUD=9600
  frontend:
    ports:
      - "80:80"
