# BFA Dryer HMI — on-panel (.env) profile.  Copy to .env on the panel.
#
# The panel's eno1 sits on the PLC LAN (10.10.10.0/24); the Schneider M221 PLC is
# at 10.10.10.10:502 and speaks UMAS (plain Modbus FC06/FC16 ACK but never apply
# on the M221 — PLC_PROTO MUST be 'umas' for live control).
#
# ============================================================================
#  *** STAYS IN SIM (PLC_SIM=true) UNTIL ON-SITE + ATTENDED. ***
#  To ARM live control of the dryer, set PLC_SIM=false (PLC_PROTO is already
#  umas below) then re-run the panel compose:
#     docker compose -f docker-compose.yml -f docker-compose.panel.yml up -d
# ============================================================================

# --- SIM vs LIVE -----------------------------------------------------------
PLC_SIM=true                 # true = in-process fake PLC (nothing moves). Flip to
                             # false ON-SITE + ATTENDED to arm live control.

# --- PLC transport (final program BFD_final.smbp) --------------------------
PLC_PROTO=umas               # M221 requires UMAS; do NOT use 'modbus' live.
PLC_HOST=10.10.10.10         # M221 on the panel's PLC LAN.
PLC_PORT=502
MODBUS_UNIT_ID=1             # ignored on the UMAS path; kept for the sim/modbus path.

# --- Polling / logging -----------------------------------------------------
POLL_MS=500
LOG_DIR=/data                # bind-mounted ./data:/data in compose (CSV logs).
LOG_INTERVAL_S=5

# --- Licence (offline kill-switch) -----------------------------------------
LICENSE_ENFORCE=true
LICENSE_REQUIRE_MACHINE=true
# MACHINE_ID=bfa-hmi-01      # blank → falls back to the host name at startup.

# --- Maintenance ----------------------------------------------------------
# PLC_RELEASE_PIN=8800       # on-panel PIN to drop the HMI's PLC link for MEB.
# DIAG_PIN=0000             # PIN for the hidden read-only PLC diagnostics screen.
#                            # CHANGE THIS — default 0000 is a placeholder. Techs
#                            # use it; normal operators do not have it.
