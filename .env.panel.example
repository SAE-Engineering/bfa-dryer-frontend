# Copy to .env on the panel.  Panel eno1 sits on the PLC LAN (10.10.10.0/24);
# the M221 PLC is at 10.10.10.10:502.
#
# *** STAYS IN SIM until on-site + attended. ***
# To arm live control of the dryer: set PLC_SIM=false then `docker compose ... up -d`.
PLC_SIM=true
PLC_HOST=10.10.10.10
PLC_PORT=502
MODBUS_UNIT_ID=1
POLL_MS=500
LOG_INTERVAL_S=5
