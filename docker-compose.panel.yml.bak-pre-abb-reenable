# Panel (production) overlay for the on-machine HMI — Lenovo M700 "bfa-hmi-01".
# Serves the frontend on host :80 so the kiosk browser hits http://localhost/.
# Bring up on the panel with:
#   docker compose -f docker-compose.yml -f docker-compose.panel.yml up -d --build
# (Do NOT name this docker-compose.override.yml — that auto-merges and would make
#  the bosun dev box also try to bind :80.)
services:
  backend:
    # Teco RS485 converter, pinned by stable USB by-id -> fixed in-container name
    # so kernel ttyUSB enumeration order can't move it on reboot.
    #   /dev/ttyTECO = FTDI FT232R USB-RS485 -> the 4 Teco E510s (incl. agitator1 node2).
    # The ABB ACS355 RS232 lead has been removed (Teco put back on agitator1); to
    # re-enable, add its by-id device + ABB_SERIAL_PORT env back here and ABB_NODE in
    # vsd_serial.py.
    devices:
      - "/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_B000VA8O-if00-port0:/dev/ttyTECO"
    environment:
      - VSD_SERIAL_PORT=/dev/ttyTECO
      - VSD_SERIAL_BAUD=9600
  frontend:
    ports:
      - "80:80"
