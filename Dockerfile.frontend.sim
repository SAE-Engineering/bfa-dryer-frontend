# SIM frontend image — builds the BFA HMI SPA with a configurable public base
# path (VITE_BASE) and serves it under that sub-path.  Used only by the bosun
# sim instance (designs.sauer.com.au/bfa/sim/); the real panel uses
# Dockerfile.frontend (base "/").

# Build stage
FROM node:20-alpine AS build
WORKDIR /app
ARG VITE_BASE=/bfa/sim/
ENV VITE_BASE=${VITE_BASE}
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install
COPY frontend ./
RUN npm run build

# Runtime stage — nginx serves the SPA under /bfa/sim/ and proxies the API/WS
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.sim.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
